# Vercel KV (required for visitor tracking)
KV_REST_API_URL=https://your-kv-instance.vercel-storage.io
KV_REST_API_READ_ONLY_TOKEN=your-token-here

# Admin authentication (required for /admin dashboard)
ADMIN_PASSWORD=change-this-to-a-strong-password

# IP hashing salt (required for privacy-safe visitor counting)
IP_HASH_SALT=change-this-to-a-random-string
