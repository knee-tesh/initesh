# Turso Database (required for visitor tracking)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Admin authentication (required for /admin dashboard)
ADMIN_PASSWORD=change-this-to-a-strong-password

# IP hashing salt (required for privacy-safe visitor counting)
IP_HASH_SALT=change-this-to-a-random-string

# TTS (Murf.ai — optional; speak buttons hide when absent)
MURF_API_KEY=
MURF_VOICE_ID=en-IN-priya

# Contact form email (Resend — optional; form falls back to mailto)
RESEND_API_KEY=
RESEND_FROM=
